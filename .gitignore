# Secrets
.env
.env.*
!.env.example
**/*secret*
**/*api_key*

# Personal deployment config: copy the tracked, sanitized template and edit locally.
/config/runtime.toml
# Removed beta diaries/scripts stay recoverable locally but must never return to Git.
/.private-history/

# Model and training artifacts
*.safetensors
*.gguf
*.bin
*.pt
*.pth
*.ckpt
models/
checkpoints/
outputs/
hf_cache/

# Generated private data
# The training project moved to archive/ when the local model route was dropped;
# its generated corpora and checkpoints stay out of Git there too.
training/data/generated/
training/data/raw/
training/runs/
archive/local_model_training/data/generated/
archive/local_model_training/data/raw/
archive/local_model_training/runs/
archive/local_model_training/**/checkpoint-*/
archive/local_model_training/**/*.gguf
archive/local_model_training/**/*.safetensors

# Runtime state
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
runtime/data/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.venv/
.venv-dev/

# Upstream checkout: a separate clone that must never be committed or published
AstrBot/

# The AstrBot adapter lives in its own repository and is cloned here for local
# development and for the docker-compose bind mount:
#   git clone https://github.com/bomomoQWQ/astrbot_plugin_companion_runtime.git
astrbot_plugin_companion_runtime/

# Local scratch space
/scratch/
.scratch_*/
/data/

# Verification-script output. All four simulations write report.json, diagnostics.log,
# transcript.md and a few runtime.sqlite3 under whatever --base-dir they are given;
# HANDOFF §3 uses ./bb-run and ./res-run, --fault runs conventionally go to ./bb-fault,
# and the memory-quality / relationship simulations are run as ./mem-run and ./res-run.
# (mem-run was missing until 2026-09-16: running the memory simulation by the book left
# an untracked directory behind, which is how it would have been committed by accident.)
/bb/
/bb-run/
/bb-fault/
/res/
/res-run/
/mem/
/mem-run/
# The relationship-progression simulation needs its own base dir too: pointing two
# simulations at one --base-dir leaves only the last report.json behind, so the earlier
# simulation's numbers are gone by the time anyone reads them.
/rel/
/rel-run/

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# 「浪潮」上线记录与回滚手册：**不入仓库**。
# 里面是真实用户的 QQ 号（上线记录按 scope 记的），而这份仓库是公开的。
# 文件仍留在本机（回滚时要用），但不能再被 git 收进来——包括 git add -A。
# 2026-10-07 之前它是被跟踪的，只是那批提交还没推送出去。
runtime/docs/浪潮决策引擎_上线记录与回滚手册_20261002.md
