# 复制为 .env；这个文件只放秘密/部署坐标，不要提交 .env。
# PostgreSQL Runtime v2 唯一必填项：
CR_STORAGE__DSN=postgresql://runtime:CHANGE_ME@postgres:5432/companion

# semantic.provider=remote_api 时填写。base_url 与 model 放 config/runtime.toml；key 只放这里。
CR_SEMANTIC_API_KEY=

# 可选：覆盖 TOML 中的部署身份。环境变量优先于配置文件。
# CR_STORAGE__SCHEMA=companion_runtime
# CR_CONVERSATION_ID=default
