{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xiaojiujiu.local/schemas/langchao_acceptance_manifest_v1.schema.json",
  "title": "Langchao preregistered acceptance manifest v1",
  "description": "A fail-closed preregistration contract. Initial manifests may only use planned or not_applicable; execution results belong in a later, separately reviewed artifact.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version", "manifest_id", "generated_at", "purpose", "release_decision",
    "baseline", "hashes", "stages", "evidence_classes", "status_policy",
    "global_protocol", "tests"
  ],
  "properties": {
    "manifest_version": {"const": "langchao.acceptance-manifest.v1"},
    "manifest_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{7,127}$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "purpose": {"type": "string", "minLength": 1},
    "release_decision": {"const": "hold_not_authorized"},
    "baseline": {
      "type": "object", "additionalProperties": false,
      "required": ["branch", "commit", "database_schema_version", "design_document", "review_standard"],
      "properties": {
        "branch": {"type": "string", "minLength": 1},
        "commit": {"$ref": "#/$defs/sha256OrCommit"},
        "database_schema_version": {"const": 20},
        "design_document": {"$ref": "#/$defs/path"},
        "review_standard": {"$ref": "#/$defs/path"}
      }
    },
    "hashes": {
      "type": "object", "additionalProperties": false,
      "required": ["commit", "acceptance_schema", "database_schema", "configuration", "review_standard"],
      "properties": {
        "commit": {"$ref": "#/$defs/hashRecord"},
        "acceptance_schema": {"$ref": "#/$defs/hashRecord"},
        "database_schema": {"$ref": "#/$defs/hashRecord"},
        "configuration": {"$ref": "#/$defs/hashRecord"},
        "review_standard": {"$ref": "#/$defs/hashRecord"}
      }
    },
    "stages": {
      "type": "array", "minItems": 5, "uniqueItems": true,
      "items": {"enum": ["design_review", "isolated_unit", "isolated_postgres", "shadow", "authorized_canary", "authorized_effect_study"]}
    },
    "evidence_classes": {
      "type": "object", "additionalProperties": false,
      "required": ["D", "C", "T", "R", "S", "I"],
      "properties": {
        "D": {"const": "versioned_design_basis"},
        "C": {"const": "source_and_call_chain_read_in_this_review"},
        "T": {"const": "isolated_execution_with_preserved_inputs_and_results"},
        "R": {"const": "authorized_real_runtime_evidence"},
        "S": {"const": "human_semantic_review_with_rubric_and_disagreement_record"},
        "I": {"const": "inference_with_explicit_premises"}
      }
    },
    "status_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["initial_allowed", "execution_allowed", "passing_status_requires_separate_result_artifact"],
      "properties": {
        "initial_allowed": {"const": ["planned", "not_applicable"]},
        "execution_allowed": {
          "const": ["planned", "running", "passed_limited", "failed", "evidence_insufficient", "not_applicable", "blocked"]
        },
        "passing_status_requires_separate_result_artifact": {"const": true}
      }
    },
    "global_protocol": {"$ref": "#/$defs/globalProtocol"},
    "tests": {
      "type": "array", "minItems": 32, "maxItems": 32,
      "items": {"$ref": "#/$defs/testCase"}
    }
  },
  "$defs": {
    "path": {"type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:|/|\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sha256OrCommit": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "hashRecord": {
      "type": "object", "additionalProperties": false,
      "required": ["algorithm", "canonicalization", "artifact", "value"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "canonicalization": {"enum": ["raw_bytes", "canonical_json_rfc8785_subset", "git_object_id"]},
        "artifact": {"type": "string", "minLength": 1},
        "value": {"$ref": "#/$defs/sha256OrCommit"}
      }
    },
    "globalProtocol": {
      "type": "object", "additionalProperties": false,
      "required": ["frozen_configuration", "denominator_policy", "tolerance_policy", "seed_policy", "timeout_policy", "privacy", "hard_blockers"],
      "properties": {
        "frozen_configuration": {"type": "object"},
        "denominator_policy": {"type": "string", "minLength": 1},
        "tolerance_policy": {"type": "string", "minLength": 1},
        "seed_policy": {"type": "string", "minLength": 1},
        "timeout_policy": {"type": "string", "minLength": 1},
        "privacy": {"$ref": "#/$defs/privacy"},
        "hard_blockers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "fixture": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "canonical_input", "sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["canonical_json", "postgres_fixture", "semantic_packet", "authorized_runtime_cohort"]},
        "canonical_input": {"type": "object"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "oracle": {
      "type": "object", "additionalProperties": false,
      "required": ["mechanical_assertions", "allowed_outcomes", "semantic_review"],
      "properties": {
        "mechanical_assertions": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "allowed_outcomes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "semantic_review": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object", "additionalProperties": false,
              "required": ["rubric", "reviewers", "adjudication", "minimum_agreement"],
              "properties": {
                "rubric": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
                "reviewers": {"type": "integer", "minimum": 2},
                "adjudication": {"type": "string", "minLength": 1},
                "minimum_agreement": {"type": "number", "minimum": 0, "maximum": 1}
              }
            }
          ]
        }
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["required_classes", "minimum_level", "artifacts"],
      "properties": {
        "required_classes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["D", "C", "T", "R", "S", "I"]}},
        "minimum_level": {"enum": ["design", "implementation", "isolated_execution", "authorized_runtime", "authorized_effect"]},
        "artifacts": {"type": "array", "items": {"$ref": "#/$defs/path"}}
      }
    },
    "positiveControl": {
      "type": "object", "additionalProperties": false,
      "required": ["fixture_delta", "expected_capability"],
      "properties": {
        "fixture_delta": {"type": "object", "minProperties": 1},
        "expected_capability": {"type": "string", "minLength": 1}
      }
    },
    "denominator": {
      "type": "object", "additionalProperties": false,
      "required": ["unit", "planned_count", "exclusions", "zero_exposure_label"],
      "properties": {
        "unit": {"enum": ["event", "goal_episode", "candidate", "decision_round", "attempt", "outcome_token", "scope", "user", "semantic_item", "paired_scenario"]},
        "planned_count": {"type": "integer", "minimum": 1},
        "exclusions": {"type": "array", "items": {"type": "string"}},
        "zero_exposure_label": {"const": "no_evaluable_exposure"}
      }
    },
    "tolerance": {
      "type": "object", "additionalProperties": false,
      "required": ["absolute", "relative", "max_steps", "zero_tolerance_invariants"],
      "properties": {
        "absolute": {"type": ["number", "null"], "minimum": 0},
        "relative": {"type": ["number", "null"], "minimum": 0},
        "max_steps": {"type": ["integer", "null"], "minimum": 1},
        "zero_tolerance_invariants": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "seed": {
      "type": "object", "additionalProperties": false,
      "required": ["required", "values", "reason"],
      "properties": {
        "required": {"type": "boolean"},
        "values": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "timeout": {
      "type": "object", "additionalProperties": false,
      "required": ["per_case_seconds", "suite_seconds", "on_timeout"],
      "properties": {
        "per_case_seconds": {"type": "integer", "minimum": 1},
        "suite_seconds": {"type": "integer", "minimum": 1},
        "on_timeout": {"const": "fail_closed_and_preserve_partial_evidence"}
      }
    },
    "privacy": {
      "type": "object", "additionalProperties": false,
      "required": ["data_class", "synthetic_only", "direct_identifiers", "retention_days", "storage", "redaction", "deletion_propagation"],
      "properties": {
        "data_class": {"enum": ["synthetic", "isolated_production_copy", "authorized_real"]},
        "synthetic_only": {"type": "boolean"},
        "direct_identifiers": {"const": "prohibited"},
        "retention_days": {"type": "integer", "minimum": 0, "maximum": 365},
        "storage": {"type": "string", "minLength": 1},
        "redaction": {"type": "string", "minLength": 1},
        "deletion_propagation": {"type": "string", "minLength": 1}
      }
    },
    "testCase": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "requirement_families", "verification_kind", "applicable_stage", "fixture", "oracle", "evidence", "positive_control", "status", "blocker", "denominator", "tolerance", "seed", "timeout", "privacy"],
      "properties": {
        "id": {"type": "string", "pattern": "^T(?:0[1-9]|[12][0-9]|3[0-2])$"},
        "title": {"type": "string", "minLength": 1},
        "requirement_families": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["MAT", "PRA", "CON", "HIS", "PUR", "VER", "AGY"]}},
        "verification_kind": {"enum": ["mechanical", "numerical", "semantic", "mixed", "effect"]},
        "applicable_stage": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["design_review", "isolated_unit", "isolated_postgres", "shadow", "authorized_canary", "authorized_effect_study"]}},
        "fixture": {"$ref": "#/$defs/fixture"},
        "oracle": {"$ref": "#/$defs/oracle"},
        "evidence": {"$ref": "#/$defs/evidence"},
        "positive_control": {"$ref": "#/$defs/positiveControl"},
        "status": {"enum": ["planned", "not_applicable"]},
        "blocker": {"type": ["string", "null"]},
        "denominator": {"$ref": "#/$defs/denominator"},
        "tolerance": {"$ref": "#/$defs/tolerance"},
        "seed": {"$ref": "#/$defs/seed"},
        "timeout": {"$ref": "#/$defs/timeout"},
        "privacy": {"$ref": "#/$defs/privacy"}
      }
    }
  }
}
