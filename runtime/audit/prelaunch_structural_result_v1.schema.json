{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xiaojiujiu.local/schemas/prelaunch_structural_result_v1.schema.json",
  "title": "Prelaunch structural evidence result v1",
  "description": "Fail-closed isolated structural and fault-injection evidence. A blocked case is evidence of a missing capability, never a synthetic pass.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "generated_at",
    "repository_root",
    "baseline",
    "runner",
    "summary",
    "results",
    "claim_limits"
  ],
  "properties": {
    "schema_version": {"const": "langchao.prelaunch-structural-result.v1"},
    "run_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "repository_root": {"$ref": "#/$defs/path"},
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "dirty"],
      "properties": {
        "commit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
        "dirty": {"type": ["boolean", "null"]}
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "python", "command", "timeout_seconds"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "python": {"type": "string", "minLength": 1},
        "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "timeout_seconds": {"type": "integer", "minimum": 1}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "passed", "failed", "blocked", "status"],
      "properties": {
        "total": {"type": "integer", "minimum": 1, "maximum": 10},
        "passed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "blocked": {"type": "integer", "minimum": 0},
        "status": {"enum": ["passed_limited", "failed", "blocked"]}
      }
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {"$ref": "#/$defs/scenarioResult"}
    },
    "claim_limits": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:|/|\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 0}
      }
    },
    "scenarioResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "canonical_requirement_id",
        "legacy_alias",
        "title",
        "status",
        "component",
        "fault_injection",
        "pytest_nodes",
        "returncode",
        "duration_seconds",
        "stdout",
        "stderr",
        "artifacts",
        "blocker",
        "claim_limit"
      ],
      "properties": {
        "id": {"enum": ["T02", "T03", "T05", "T08", "T10", "T12", "T14", "T15", "T16", "T20"]},
        "canonical_requirement_id": {"type": "string", "pattern": "^LC-(?:MAT|PRA|CON|HIS|PUR|VER|AGY)-[0-9]{2}$"},
        "legacy_alias": {
          "type": "object", "additionalProperties": false,
          "required": ["namespace", "id"],
          "properties": {
            "namespace": {"type": "string", "minLength": 1},
            "id": {"pattern": "^T(?:0[1-9]|[12][0-9]|3[0-2])$"}
          }
        },
        "title": {"type": "string", "minLength": 1},
        "status": {"enum": ["passed_limited", "failed", "blocked"]},
        "component": {"type": "string", "minLength": 1},
        "fault_injection": {"type": "string", "minLength": 1},
        "pytest_nodes": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "returncode": {"type": ["integer", "null"]},
        "duration_seconds": {"type": "number", "minimum": 0},
        "stdout": {"type": "string"},
        "stderr": {"type": "string"},
        "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
        "blocker": {"type": ["string", "null"]},
        "claim_limit": {"type": "string", "minLength": 1}
      }
    }
  }
}
